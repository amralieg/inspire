{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "focus_spec",
  "description": "One guided focus per use case: the AI writes it at generation time, the App renders it with a fixed library. The python (server/focus_spec.py) and JS (web/src/focusSpec.js) validators read the x-rules block below, so both give the same verdict.",
  "type": "object",
  "required": ["version", "technique_kind", "tour", "queue", "steps", "decide"],
  "properties": {
    "version": {"const": 1},
    "technique_kind": {"type": "string", "minLength": 1},
    "tour": {"type": "array", "minItems": 1, "maxItems": 5,
      "items": {"type": "object", "required": ["target", "line"], "properties": {"target": {"type": "string"}, "line": {"type": "string"}}}},
    "queue": {"type": "object", "required": ["filter", "order"],
      "properties": {"filter": {"type": "string"}, "order": {"type": "object", "required": ["column", "direction"],
        "properties": {"column": {"type": "string"}, "direction": {"enum": ["asc", "desc"]}}}, "cohort_column": {"type": "string"}}},
    "steps": {"type": "array", "minItems": 2, "maxItems": 5,
      "items": {"type": "object", "required": ["id", "question", "kind", "visual", "answer_template", "terms", "motion", "ask"],
        "properties": {"id": {"type": "string"}, "question": {"type": "string"}, "kind": {"enum": ["show", "compare", "explain", "decide"]},
          "visual": {"type": "object", "required": ["block", "bind"],
            "properties": {"block": {"type": "string"}, "bind": {"type": "object", "additionalProperties": {"type": "string"}},
              "compare": {"enum": ["history", "cohort", "picked", "population"]}, "default_compare": {"type": "boolean"}}},
          "answer_template": {"type": "string"}, "terms": {"type": "array", "maxItems": 3},
          "motion": {"type": "string"}, "ask": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "string"}}}}},
    "decide": {"type": "object", "required": ["choices"],
      "properties": {"choices": {"type": "array", "minItems": 1, "maxItems": 4,
        "items": {"type": "object", "required": ["label", "detail", "action"],
          "properties": {"label": {"type": "string"}, "detail": {"type": "string"}, "action": {"type": "string"}, "needs_note": {"type": "boolean"}}}}}}
  },
  "x-rules": {
    "blocks": ["bridge", "strip", "histogram", "trend_band", "ranked_bars", "small_multiples", "share_shift", "before_after", "funnel", "network", "map_pin", "gauge", "timeline", "cohort_cards"],
    "motions": ["build", "count_up", "morph", "pulse", "slide", "fill", "trace", "split_merge", "zoom", "reveal"],
    "compares": ["history", "cohort", "picked", "population"],
    "step_kinds": ["show", "compare", "explain", "decide"],
    "directions": ["asc", "desc"],
    "default_actions": ["done", "not_an_issue", "snooze", "assign"],
    "column_types": ["number", "string", "date"],
    "caps": {"tour_stops": [1, 5], "steps": [2, 5], "ask": [2, 3], "terms": [0, 3], "choices": [1, 4],
      "tour_line_words": 14, "question_words": 12, "ask_words": 12, "answer_template_words": 20,
      "choice_label_words": 6, "choice_detail_words": 12, "term_plain_words": 25},
    "block_roles": {
      "bridge": {"label": "string", "value": "number"},
      "strip": {"value": "number"},
      "histogram": {"value": "number"},
      "trend_band": {"time": "date", "value": "number"},
      "ranked_bars": {"label": "string", "value": "number"},
      "small_multiples": {"label": "string", "value": "number"},
      "share_shift": {"label": "string", "value": "number"},
      "before_after": {"label": "string", "before": "number", "after": "number"},
      "funnel": {"stage": "string", "value": "number"},
      "network": {"source": "string", "target": "string"},
      "map_pin": {"region": "string", "value": "number"},
      "gauge": {"value": "number", "threshold": "number"},
      "timeline": {"time": "date", "label": "string"},
      "cohort_cards": {"group": "string", "value": "number"}
    },
    "block_optional_roles": {
      "bridge": {"key": "string"},
      "strip": {"label": "string", "key": "string"},
      "histogram": {"key": "string"},
      "trend_band": {"low": "number", "high": "number", "key": "string"},
      "ranked_bars": {"key": "string"},
      "small_multiples": {"x": "string", "key": "string"},
      "share_shift": {"before": "number", "key": "string"},
      "before_after": {"key": "string"},
      "funnel": {"key": "string"},
      "network": {"value": "number", "key": "string"},
      "map_pin": {"x": "number", "y": "number", "label": "string", "key": "string"},
      "gauge": {"label": "string", "key": "string"},
      "timeline": {"value": "number", "key": "string"},
      "cohort_cards": {"count": "number", "key": "string"}
    },
    "notes": "default_actions is the App's record action set (shell_agent.OFFER_ACTIONS, AgentParts.jsx OFFER_BUTTONS); a test keeps it equal. block_optional_roles are columns a block may also read (type-checked when bound, never required); a role in neither list is unknown_role. columns passed to a validator map column name to number, string or date."
  }
}
